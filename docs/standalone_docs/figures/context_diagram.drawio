<mxfile>
  <diagram name="Context" id="ctx">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- System Boundary -->
        <mxCell id="sys" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;dashed=1;dashPattern=8 4;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="120" width="700" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="sysLabel" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Quantum Virtual Machine (QVM)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="130" width="360" height="30" as="geometry"/>
        </mxCell>

        <!-- Internal Modules -->
        <mxCell id="parser" value="&lt;b&gt;Parser Module&lt;/b&gt;&lt;br&gt;(QASM 2.0 / 3.0 / JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="200" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ir" value="&lt;b&gt;QuantumCircuit IR&lt;/b&gt;&lt;br&gt;(Intermediate Representation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="200" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="decomp" value="&lt;b&gt;Decomposer&lt;/b&gt;&lt;br&gt;(Gate Breakdown)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="310" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="transpiler" value="&lt;b&gt;Transpiler&lt;/b&gt;&lt;br&gt;(Greedy BFS / SABRE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="310" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="simSV" value="&lt;b&gt;Statevector Simulator&lt;/b&gt;&lt;br&gt;(exact, ≤12 qubits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="420" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="simMPS" value="&lt;b&gt;MPS Simulator&lt;/b&gt;&lt;br&gt;(tensor network, 20+ qubits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="420" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="visual" value="&lt;b&gt;Visualizer&lt;/b&gt;&lt;br&gt;(Matplotlib)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="530" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Interfaces inside system -->
        <mxCell id="cli" value="&lt;b&gt;CLI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#455A64;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="930" y="200" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;REST API&lt;/b&gt;&lt;br&gt;(FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#455A64;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="930" y="310" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="webgui" value="&lt;b&gt;Web GUI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#455A64;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="930" y="420" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- External Actors -->
        <mxCell id="dev" value="&lt;b&gt;Quantum Algorithm&lt;br&gt;Developer&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="170" width="40" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="student" value="&lt;b&gt;Educational&lt;br&gt;User&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="370" width="40" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;System&lt;br&gt;Administrator&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="560" width="40" height="70" as="geometry"/>
        </mxCell>

        <!-- External Systems -->
        <mxCell id="fs" value="&lt;b&gt;File System&lt;/b&gt;&lt;br&gt;(Circuit Files,&lt;br&gt;Output Files)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;strokeWidth=1.5;fontSize=11;size=15;" vertex="1" parent="1">
          <mxGeometry x="1250" y="170" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Web Browser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1250" y="330" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ibm" value="&lt;b&gt;IBM Quantum&lt;br&gt;Platform&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1250" y="480" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- Actor → System edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;" edge="1" source="dev" target="cli" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1l" value="Circuit files,&lt;br&gt;CLI commands" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" connectable="0" parent="e1">
